# =============================================================================
# pg-cdc — Shared Environment Variables
# =============================================================================
# This file is sourced by systemd units and shell scripts.
# Deployment: place at /etc/pg-cdc/pg-cdc.env

PGCDC_CONNECTION_STRING="postgresql://postgres:password@localhost:5432/postgres"
PGCDC_CAPTURE_DIR="/var/pg-cdc"
PGCDC_BACKUP_DIR="/var/backups/pg"
PGCDC_SCRIPTS_DIR="/etc/pg-cdc"
PGCDC_ALERT_COMMAND="/etc/pg-cdc/alert.sh"

# Safety valve thresholds
PGCDC_MAX_LAG_BYTES="1073741824"
PGCDC_GRACE_PERIOD_SECONDS="300"

# Monitoring thresholds
PGCDC_LAG_WARN_BYTES="52428800"
PGCDC_SLOT_INACTIVE_SECONDS="600"
PGCDC_STREAM_STALE_SECONDS="120"

# Baseline concurrency
PGCDC_BASELINE_CONCURRENCY="3"
